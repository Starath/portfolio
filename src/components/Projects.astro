---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const rawProjects = await getCollection('projects');
const projects = rawProjects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<section id="projects" class="projects-section">
  <div class="section-header">
    <span class="section-label">03 // Work</span>
    <h2 class="section-title">Selected Projects & Systems</h2>
    <p class="section-desc">Practical implementations spanning network transport protocols, AI vision classification, and algorithmic retrieval.</p>
  </div>

  <div class="projects-feed">
    {projects.map((project, index) => (
      <ProjectCard project={project} index={index} />
    ))}
  </div>
</section>

<style>
  .projects-feed {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
</style>
