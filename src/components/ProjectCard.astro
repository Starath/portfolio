---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, context, description, problem, solution, stack = [], link } = project.data;

const id = project.id;
---

<article class="project-entry" id={`project-${id}`}>
  <div class="entry-header">
    <div class="entry-meta">
      <span class="entry-index">0{index + 1} //</span>
      <span class="entry-context">{context}</span>
    </div>
    <h3 class="entry-title">{title}</h3>
  </div>

  <p class="entry-desc">{description}</p>

  <!-- Technical Architecture Diagram / Blueprint (Explicitly labeled as illustrative schematics) -->
  {id.includes('chattcp') && (
    <div class="technical-blueprint">
      <div class="blueprint-header">
        <span class="blueprint-tag">SYSTEM ARCHITECTURE // PROTOCOL FRAMING SPEC</span>
        <button type="button" class="sim-btn" id="sim-handshake-btn" aria-label="Simulate 3-way packet handshake">
          <span>&gt; Trace Protocol Handshake</span>
        </button>
      </div>
      
      <div class="packet-frame-grid" aria-label="Packet Header Specification Schema">
        <div class="frame-cell"><span class="cell-label">FLAGS</span><span class="cell-val">SYN | ACK | FIN</span></div>
        <div class="frame-cell"><span class="cell-label">SEQ_NUM</span><span class="cell-val">32-bit Integer</span></div>
        <div class="frame-cell"><span class="cell-label">ACK_NUM</span><span class="cell-val">32-bit Integer</span></div>
        <div class="frame-cell"><span class="cell-label">WINDOW</span><span class="cell-val">Sliding Buffer</span></div>
        <div class="frame-cell"><span class="cell-label">CHECKSUM</span><span class="cell-val">16-bit 1's Comp</span></div>
      </div>

      <div class="trace-output" id="handshake-trace" aria-live="polite">
        <span class="trace-line">[ILLUSTRATIVE] Click button above to simulate 3-way connection trace.</span>
      </div>
    </div>
  )}

  {id.includes('setorin') && (
    <div class="technical-blueprint">
      <div class="blueprint-header">
        <span class="blueprint-tag">SCHEMATIC // INFERENCE & TELEMETRY FLOW</span>
        <span class="schematic-note">[CONCEPTUAL ARCHITECTURE]</span>
      </div>
      
      <div class="cv-hud-mock">
        <div class="hud-box">
          <div class="hud-top">
            <span class="hud-class">MODEL: YOLOv8 Object Detector</span>
            <span class="hud-conf">INPUT: OpenCV Video Frame</span>
          </div>
          <div class="hud-telemetry">
            <span>&bull; Multi-Class Waste Classification</span>
            <span>&bull; Actuation Trigger Logic</span>
            <span>&bull; IoT Sensor Telemetry to Backend</span>
          </div>
        </div>
      </div>
    </div>
  )}

  {id.includes('audio') && (
    <div class="technical-blueprint">
      <div class="blueprint-header">
        <span class="blueprint-tag">SCHEMATIC // FEATURE EXTRACTION & RETRIEVAL PIPELINE</span>
        <span class="schematic-note">[VECTOR MATRICES]</span>
      </div>
      
      <div class="vector-pipeline">
        <div class="pipe-step">
          <span class="step-num">01</span>
          <span class="step-name">MIDI Stream</span>
          <span class="step-detail">mido Event Parser</span>
        </div>
        <div class="pipe-arrow">&rarr;</div>
        <div class="pipe-step">
          <span class="step-num">02</span>
          <span class="step-name">Pitch Histograms</span>
          <span class="step-detail">128-bin ATB / 255-bin RTB</span>
        </div>
        <div class="pipe-arrow">&rarr;</div>
        <div class="pipe-step">
          <span class="step-num">03</span>
          <span class="step-name">Cosine Ranking</span>
          <span class="step-detail">Similarity vs Dataset Index</span>
        </div>
      </div>
    </div>
  )}

  {id.includes('alchemy') && (
    <div class="technical-blueprint">
      <div class="blueprint-header">
        <span class="blueprint-tag">SCHEMATIC // GRAPH SEARCH RECIPE DEPENDENCIES</span>
        <span class="schematic-note">[GRAPH MODEL]</span>
      </div>
      
      <div class="graph-tree-preview">
        <div class="tree-branch">
          <span class="node-root">[Target Element]</span>
          <span class="branch-arrow">&larr;</span>
          <span class="node-leaf">[Ingredient A]</span>
          <span class="node-op">+</span>
          <span class="node-leaf">[Ingredient B]</span>
          <span class="branch-metric">(BFS: Shortest Crafting Path)</span>
        </div>
        <div class="tree-branch">
          <span class="node-root">[Target Element]</span>
          <span class="branch-arrow">&larr;</span>
          <span class="node-leaf">[Sub-Recipe Tree]</span>
          <span class="branch-arrow">&larr;</span>
          <span class="node-leaf">[Base Elements]</span>
          <span class="branch-metric">(DFS: Exhaustive Traversal)</span>
        </div>
      </div>
    </div>
  )}

  {problem && solution && (
    <div class="case-details">
      <div class="detail-block">
        <span class="detail-label">Problem:</span>
        <span class="detail-text">{problem}</span>
      </div>
      <div class="detail-block">
        <span class="detail-label">Engineering:</span>
        <span class="detail-text">{solution}</span>
      </div>
    </div>
  )}

  <div class="entry-footer">
    <div class="stack-list" aria-label="Technical components used">
      {stack.map((item: string) => (
        <span class="mono-tag">{item}</span>
      ))}
    </div>

    <a
      href={link}
      target="_blank"
      rel="noopener noreferrer"
      class="repo-link"
      aria-label={`View ${title} repository on GitHub (opens in new tab)`}
    >
      <span>Repository</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="7" y1="17" x2="17" y2="7"></line>
        <polyline points="7 7 17 7 17 17"></polyline>
      </svg>
    </a>
  </div>
</article>

<script is:inline>
  const simBtn = document.getElementById('sim-handshake-btn');
  const traceOutput = document.getElementById('handshake-trace');

  if (simBtn && traceOutput) {
    simBtn.addEventListener('click', () => {
      traceOutput.replaceChildren();
      const loading = document.createElement('span');
      loading.className = 'trace-line';
      loading.textContent = 'Simulating 3-way packet handshake sequence...';
      traceOutput.appendChild(loading);
      
      setTimeout(() => {
        traceOutput.replaceChildren();

        const createRow = (arrow, text) => {
          const row = document.createElement('div');
          row.className = 'trace-row';
          const arrSpan = document.createElement('span');
          arrSpan.className = 'trace-arrow';
          arrSpan.textContent = arrow;
          const textSpan = document.createElement('span');
          textSpan.textContent = text;
          row.append(arrSpan, textSpan);
          return row;
        };

        traceOutput.appendChild(createRow('→', ' CLIENT: [SYN] (Initial sequence number)'));
        traceOutput.appendChild(createRow('←', ' SERVER: [SYN, ACK] (Acknowledgment + Server SEQ)'));
        traceOutput.appendChild(createRow('→', ' CLIENT: [ACK] (Handshake complete)'));

        const statusDiv = document.createElement('div');
        statusDiv.className = 'trace-status';
        const okSpan = document.createElement('span');
        okSpan.className = 'status-ok';
        okSpan.textContent = '✓ [SIMULATED] CONNECTION ESTABLISHED & SLIDING WINDOW READY';
        statusDiv.appendChild(okSpan);
        traceOutput.appendChild(statusDiv);
      }, 400);
    });
  }
</script>

<style>
  .project-entry {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 1.85rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .project-entry:hover {
    background-color: var(--bg-surface-elevated);
    border-color: var(--border-strong);
  }

  .entry-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .entry-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .entry-index {
    color: var(--accent);
    font-weight: 600;
  }

  .entry-context {
    color: var(--text-muted);
  }

  .entry-title {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .entry-desc {
    font-size: 0.94rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Technical Blueprint Styles */
  .technical-blueprint {
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    padding: 1rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-family: var(--font-mono);
  }

  .blueprint-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.72rem;
    border-bottom: 1px dashed var(--border-default);
    padding-bottom: 0.6rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .blueprint-tag {
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .schematic-note {
    color: var(--text-muted);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
  }

  .sim-btn {
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-strong);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .sim-btn:hover {
    background-color: var(--accent);
    color: var(--bg-canvas);
  }

  /* Packet Frame Grid */
  .packet-frame-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.4rem;
    font-size: 0.72rem;
  }

  .frame-cell {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    padding: 0.4rem 0.5rem;
    border-radius: var(--radius-xs);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .cell-label {
    color: var(--text-muted);
    font-size: 0.65rem;
  }

  .cell-val {
    color: var(--text-primary);
    font-weight: 600;
  }

  .trace-output {
    background-color: #07080A;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xs);
    padding: 0.65rem 0.85rem;
    font-size: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .trace-line {
    color: var(--text-muted);
  }

  .trace-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
  }

  .trace-arrow {
    color: var(--accent);
    font-weight: 700;
  }

  .trace-status {
    margin-top: 0.2rem;
    padding-top: 0.3rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.08);
  }

  .status-ok {
    color: var(--accent);
    font-weight: 600;
  }

  /* CV HUD Mock */
  .cv-hud-mock {
    background-color: #07080A;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xs);
    padding: 0.85rem 1rem;
  }

  .hud-box {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .hud-top {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    font-weight: 600;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hud-class { color: var(--accent); }
  .hud-conf { color: var(--text-secondary); }

  .hud-telemetry {
    display: flex;
    gap: 1rem;
    font-size: 0.72rem;
    color: var(--text-muted);
    flex-wrap: wrap;
  }

  /* Vector Pipeline */
  .vector-pipeline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: #07080A;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xs);
    padding: 0.75rem 1rem;
    gap: 0.5rem;
    overflow-x: auto;
  }

  .pipe-step {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .step-num {
    font-size: 0.65rem;
    color: var(--accent);
    font-weight: 700;
  }

  .step-name {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .step-detail {
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .pipe-arrow {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  /* Graph Tree Preview */
  .graph-tree-preview {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    background-color: #07080A;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xs);
    padding: 0.75rem 1rem;
    font-size: 0.75rem;
  }

  .tree-branch {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .node-root { color: var(--accent); font-weight: 600; }
  .node-leaf { color: var(--text-primary); }
  .node-op, .branch-arrow { color: var(--text-muted); }
  .branch-metric { color: var(--text-muted); font-size: 0.7rem; margin-left: auto; }

  /* Case Details */
  .case-details {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .detail-block {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .detail-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .detail-text {
    color: var(--text-secondary);
  }

  .entry-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .repo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: none;
    padding: 0.35rem 0.7rem;
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .repo-link:hover {
    color: var(--accent);
    border-color: var(--border-accent);
  }

  @media (max-width: 768px) {
    .project-entry {
      padding: 1.35rem 1.25rem;
    }

    .packet-frame-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .entry-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
