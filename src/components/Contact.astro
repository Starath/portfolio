---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const socialChannels = [
  {
    name: 'GitHub',
    handle: 'Starath',
    url: 'https://github.com/Starath',
    domain: 'github.com/Starath',
    desc: 'Public repositories, source code & coursework',
    icon: `${baseUrl}/contact/github_logo.svg`,
    isCode: true,
  },
  {
    name: 'LinkedIn',
    handle: 'athian-nugraha-muarajuang',
    url: 'https://www.linkedin.com/in/athian-nugraha-muarajuang-15a39129a/',
    domain: 'linkedin.com/in/athian-nugraha-muarajuang',
    desc: 'Academic network & professional background',
    icon: `${baseUrl}/contact/linkedin_logo.svg`,
    isCode: false,
  },
  {
    name: 'Instagram',
    handle: '@tyanstah',
    url: 'https://Instagram.com/tyanstah',
    domain: 'instagram.com/tyanstah',
    desc: 'Personal updates & campus life',
    icon: `${baseUrl}/contact/instagram_logo.svg`,
    isCode: false,
  },
];

const email = 'athianbintang@gmail.com';
---

<section id="contact" class="contact-section">
  <div class="section-header">
    <span class="section-label">04 // Contact</span>
    <h2 class="section-title">Initiate Transmission</h2>
    <p class="section-desc">
      Open for discussions on back-end systems, socket protocols, computer vision pipelines, internship opportunities, or academic collaboration.
    </p>
  </div>

  <div class="terminal-dispatch-hub">
    <!-- Terminal Top Header -->
    <div class="dispatch-header">
      <div class="dispatch-status">
        <span class="status-pulse" aria-hidden="true"></span>
        <span class="status-text">DISPATCH: ACTIVE // INBOX OPEN</span>
      </div>
      <div class="dispatch-meta">
        <span>CHANNEL: ASYNC INBOX</span>
      </div>
    </div>

    <!-- Main Contact Grid -->
    <div class="dispatch-grid">
      <!-- Left: Direct Email Panel -->
      <div class="email-panel">
        <div class="panel-tag">PRIMARY_CHANNEL // ASYNC_MAIL</div>
        <div class="email-display">
          <span class="email-proto">mailto://</span>
          <span class="email-text" id="target-email">{email}</span>
        </div>
        <p class="panel-note">
          Direct route for software engineering roles, systems discussions, or technical inquiries.
        </p>

        <div class="panel-actions">
          <button
            type="button"
            id="copy-address-btn"
            class="action-btn btn-copy"
            aria-label="Copy email address to clipboard"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="12" height="12" rx="2"></rect>
              <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path>
            </svg>
            <span id="copy-btn-text">Copy Address</span>
          </button>
          
          <a
            href={`mailto:${email}`}
            class="action-btn btn-compose"
            aria-label="Compose email in default client"
          >
            <span>Compose Email</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Accessible Live Announcement for Screen Readers -->
        <div id="copy-live-status" role="status" aria-live="polite" class="sr-only"></div>
      </div>

      <!-- Right: Channel Directory -->
      <div class="channels-panel">
        <div class="panel-tag">NETWORK_ENDPOINTS // VERIFIED_CHANNELS</div>
        <ul class="channels-list">
          {socialChannels.map((channel) => (
            <li>
            <a
              href={channel.url}
              target="_blank"
              rel="noopener noreferrer"
              class="channel-item"
              aria-label={`${channel.name}: ${channel.handle} (opens in new tab)`}
            >
              <div class="channel-icon-box">
                <img
                  src={channel.icon}
                  alt=""
                  width="18"
                  height="18"
                  loading="lazy"
                  decoding="async"
                  class={`channel-icon ${channel.isCode ? 'invert-icon' : ''}`}
                />
              </div>
              <div class="channel-info">
                <div class="channel-header-row">
                  <span class="channel-title">{channel.name}</span>
                  <span class="channel-handle">{channel.handle}</span>
                </div>
                <span class="channel-desc">{channel.desc}</span>
              </div>
              <span class="channel-link-icon" aria-hidden="true">&nearr;</span>
            </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const copyAddressBtn = document.getElementById('copy-address-btn');
  const copyBtnText = document.getElementById('copy-btn-text');
  const liveStatus = document.getElementById('copy-live-status');
  const emailString = 'athianbintang@gmail.com';

  if (copyAddressBtn && copyBtnText) {
    copyAddressBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(emailString);
        copyBtnText.textContent = 'Address copied';
        copyAddressBtn.classList.add('copied');
        if (liveStatus) {
          liveStatus.textContent = 'Email address copied to clipboard.';
        }
        setTimeout(() => {
          copyBtnText.textContent = 'Copy Address';
          copyAddressBtn.classList.remove('copied');
          if (liveStatus) {
            liveStatus.textContent = '';
          }
        }, 2500);
      } catch {
        prompt('Copy email address:', emailString);
        if (liveStatus) {
          liveStatus.textContent = 'Clipboard write failed. Displayed email in prompt fallback.';
        }
      }
    });
  }
</script>

<style>
  .contact-section {
    padding: 4.5rem 0;
  }

  /* Screen reader only utility */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Transmission Terminal Hub */
  .terminal-dispatch-hub {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .dispatch-header {
    background-color: var(--bg-terminal);
    padding: 0.65rem 1.25rem;
    border-bottom: 1px solid var(--border-default);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .dispatch-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .status-pulse {
    width: 6px;
    height: 6px;
    background-color: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--accent);
  }

  .dispatch-meta {
    color: var(--text-muted);
    font-size: 0.7rem;
  }

  /* Grid inside Hub */
  .dispatch-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    border-top: 1px solid var(--border-subtle);
  }

  /* Left Email Panel */
  .email-panel {
    padding: 2rem 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border-right: 1px solid var(--border-default);
  }

  .panel-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    overflow-wrap: anywhere;
  }

  .email-display {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.85rem 1.1rem;
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    flex-wrap: wrap;
    min-width: 0;
  }

  .email-proto {
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .email-text {
    min-width: 0;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    overflow-wrap: anywhere;
  }

  .panel-note {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .panel-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    gap: 0.45rem;
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .btn-copy {
    background-color: var(--bg-surface-elevated);
    color: var(--text-primary);
    border: 1px solid var(--border-default);
  }

  .btn-copy:hover {
    border-color: var(--border-strong);
    background-color: var(--bg-surface-hover);
  }

  .btn-copy.copied {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--accent-dim);
  }
  .action-btn:focus-visible,
  .channel-item:focus-visible {
    border-color: var(--border-focus);
    outline: 2px solid var(--border-focus);
    outline-offset: 3px;
  }

  .btn-compose {
    background-color: var(--accent);
    color: #0A0A0C;
    border: 1px solid var(--accent);
    font-weight: 600;
  }

  .btn-compose:hover {
    background-color: #059669;
    border-color: #059669;
    color: #ffffff;
  }


  /* Right Channels Panel */
  .channels-panel {
    padding: 2rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background-color: var(--bg-terminal);
  }

  .channels-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .channel-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0.95rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    text-decoration: none;
    min-width: 0;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .channel-item:hover {
    background-color: var(--bg-surface-elevated);
    border-color: var(--border-strong);
  }

  .channel-icon-box {
    width: 32px;
    height: 32px;
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xs);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .channel-icon {
    width: 18px;
    height: 18px;
    opacity: 0.9;
  }

  .invert-icon {
    filter: invert(1);
  }
  .channel-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex-grow: 1;
    min-width: 0;
  }

  .channel-header-row {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .channel-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .channel-handle {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--accent);
    overflow-wrap: anywhere;
  }

  .channel-desc {
    font-size: 0.76rem;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .channel-link-icon {
    flex-shrink: 0;
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: color var(--transition-fast);
  }

  .channel-item:hover .channel-link-icon {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .dispatch-grid {
      grid-template-columns: 1fr;
    }

    .email-panel {
      border-right: none;
      border-bottom: 1px solid var(--border-default);
      padding: 1.5rem;
    }

    .channels-panel {
      padding: 1.5rem;
    }
  }
  @media (max-width: 480px) {
    .email-display {
      align-items: flex-start;
    }

    .panel-actions {
      align-items: stretch;
    }

    .action-btn {
      width: 100%;
    }

    .channel-header-row {
      row-gap: 0.15rem;
    }
  }
</style>
